{
  "_comment": "M-001 烟测配置：使用 mimo 走 OpenAI 兼容协议。apiKey 从环境变量 MEMORA_LLM_API_KEY 注入。",
  "llm": {
    "provider": "mimo",
    "model": "mimo-v2.5-pro",
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "${MEMORA_LLM_API_KEY}",
    "temperature": 0.7
  },
  "memory": {
    "dataDir": "f:/zooique/memora/examples/memories",
    "maxContextTokens": 120000
  },
  "security": {
    "permission": "owner",
    "confirmWrites": false
  },
  "allowedPaths": []
}
