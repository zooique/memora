data/local/

# Memora 运行时目录（宿主项目使用时生成，开发项目不应包含）
.memora/

# 运行时配置（含本地路径和 API 端点，不入库）
config/smoke-*.json

# SQLite 数据库（运行时产物，不入库）
*.db
*.db-journal
*.db-wal
*.db-shm
.smoke-test/

# 测试覆盖率
.nyc_output/

# OS
desktop.ini
$RECYCLE.BIN/

# TypeScript
*.tsbuildinfo

# 项目级运行时数据
.memora/projects.json
.memora-sprite/

