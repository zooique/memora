# 依赖
node_modules/

# 构建产物
dist/
build/
coverage/

# 日志
*.log
logs/
.pino*

# 环境变量与密钥
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
*.p8
.credentials
.netrc
.pgpass
credentials.json
token.json
service-account*.json

# 编辑器
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 用户特定数据
.memora-data/
data/local/

# Memora 运行时目录（宿主项目使用时生成，开发项目不应包含）
.memora/

# 运行时配置（含本地路径和 API 端点，不入库）
config/smoke-*.json

# SQLite 数据库（运行时产物，不入库）
*.db
*.db-journal
*.db-wal
*.db-shm
.smoke-test/

# 测试覆盖率
.nyc_output/

# OS
desktop.ini
$RECYCLE.BIN/

# TypeScript
*.tsbuildinfo

# 项目级运行时数据
.memora/projects.json
.memora-sprite/

# 测试临时目录
test-sprite-*/
hosts/memora-sprite/dist-electron
hosts/memora-sprite/dist-electron/*
hosts/memora-sprite/dist-preload
hosts/memora-sprite/dist-preload/*
