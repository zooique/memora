{
  "name": "@zooique/memora",
  "version": "3.0.0",
  "description": "Node.js 专用 Agent 架构 — 本地、私有、领域无关，万物皆记忆（零第三方运行时依赖，依赖 Node.js 内置模块）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "config.example.json",
    "role-packs",
    "docs/memora-api-reference.md",
    "docs/memora-接入指南.md",
    "docs/role-pack-开放键指南.md",
    "docs/architecture/role-pack-spec.md",
    "docs/architecture/role-pack-authoring-guide.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ask-parser": {
      "import": "./dist/utils/askParser.js",
      "types": "./dist/utils/askParser.d.ts",
      "default": "./dist/utils/askParser.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zooique/memora.git"
  },
  "homepage": "https://gitee.com/zooique/memora#readme",
  "bugs": {
    "url": "https://gitee.com/zooique/memora/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npx rimraf dist && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "memora",
    "agent",
    "memory",
    "agent-memory",
    "llm",
    "ai",
    "local-first",
    "local-ai",
    "embedding",
    "vector-search",
    "rag",
    "typescript",
    "zero-dependency",
    "semantic-search",
    "knowledge-base",
    "记忆",
    "智能体",
    "本地优先"
  ],
  "author": "Memora Contributors",
  "license": "MIT",
  "peerDependencies": {
    "pino": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
