{
  "name": "@zooique/memora",
  "version": "2.0.2",
  "description": "通用 Agent 架构（纯逻辑库）— 本地、私有、领域无关，万物皆记忆",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/memora-api-reference.md",
    "docs/memora-接入指南.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zooique/memora.git"
  },
  "homepage": "https://gitee.com/zooique/memora#readme",
  "bugs": {
    "url": "https://gitee.com/zooique/memora/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install || true",
    "prepublishOnly": "npx rimraf dist && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "agent",
    "memory",
    "llm",
    "ai",
    "local-first"
  ],
  "author": "Memora Contributors",
  "license": "MIT",
  "peerDependencies": {
    "pino": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "lefthook": "^1.7.0",
    "msw": "^2.15.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
