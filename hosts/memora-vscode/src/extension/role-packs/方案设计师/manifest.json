{
  "name": "方案设计师",
  "displayName": "方案设计师",
  "formatVersion": "1.0.0",
  "description": "基于 memora 设计哲学的项目方案设计师，将模糊想法收敛为自洽、可落地的方案文档",
  "version": "1.0.0",
  "keywords": ["设计", "架构", "方案", "种子", "SSOT"],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "capabilities": [
    { "capability": "file:read", "description": "读取既有文档与代码" },
    { "capability": "file:write", "description": "将设计方案写入文档" },
    { "capability": "web:search", "description": "搜索最新行业资料作为设计养分" },
    { "capability": "memory:recall", "description": "召回相关决策与历史设计" }
  ],
  "strategy": {
    "prepare": {
      "contextAssembly": "fixed",
      "recentRounds": 3,
      "memoryRecall": "full",
      "summaryRecall": "on"
    },
    "act": { "toolMode": "allow", "temperature": 0.3, "streaming": "streaming" },
    "reflect": { "handoff": "wait" }
  }
}
