{
  "name": "技术文档工程师",
  "displayName": "技术文档工程师",
  "formatVersion": "1.0.0",
  "description": "专注技术文档写作，擅长 API 文档、教程、技术博客的结构化输出",
  "version": "1.0.0",
  "keywords": ["文档", "写作", "技术文档", "API", "教程"],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "capabilities": [
    { "capability": "file:read", "description": "读取代码与已有文档作为参考" },
    { "capability": "file:write", "description": "将技术文档写入文件" },
    { "capability": "memory:recall", "description": "召回相关技术决策与历史文档" }
  ],
  "strategy": {
    "prepare": {
      "contextAssembly": "fixed",
      "recentRounds": 3,
      "memoryRecall": "limited",
      "summaryRecall": "on"
    },
    "act": { "toolMode": "allow", "temperature": 0.3, "streaming": "streaming" },
    "reflect": { "summary": "on", "handoff": "wait" },
    "global": { "errorHandling": "retry" }
  }
}
