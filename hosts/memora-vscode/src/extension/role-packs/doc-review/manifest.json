{
  "name": "doc-review",
  "displayName": "文档审查员",
  "formatVersion": "1.0.0",
  "description": "专业项目文档顾问与代码架构师，审阅设计文档自洽性并根据文档生成项目代码骨架",
  "version": "1.0.0",
  "keywords": ["文档", "审查", "代码", "骨架", "架构"],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "capabilities": [
    { "capability": "file:read", "description": "读取项目文档与代码文件" },
    { "capability": "file:write", "description": "写入代码骨架与占位实现" },
    { "capability": "memory:recall", "description": "召回相关决策与历史设计" }
  ],
  "strategy": {
    "prepare": {
      "contextAssembly": "fixed",
      "recentRounds": 3,
      "memoryRecall": "limited",
      "summaryRecall": "on"
    },
    "act": { "toolMode": "allow", "temperature": 0.3, "streaming": "streaming" },
    "reflect": { "handoff": "wait" }
  }
}
