# 源码（已编译到 dist）
src/**
scripts/**
tsconfig.json
tsconfig.scripts.json
vitest.config.ts
esbuild.config.mjs
eslint.config.mjs

# 锁文件（依赖真源在仓库，运行时已 esbuild 内联，不入市场包）
pnpm-lock.yaml
package-lock.json

# 版本控制
.gitignore
.git/**
**/.gitkeep

# 运行时数据（本地会话/锁文件，绝不入包）
.memora/**

# 文档
docs/**
*.md
!README.md
# 扩展详情页的「Changelog」标签读的就是包内这个文件（生成物，真源 = 仓库根 CHANGELOG 的宿主区）。
# 2026-10-30 实测：0.4.0 的 vsix 只含 readme.md ⇒ 市场页 Changelog 标签是空的。
!CHANGELOG.md

# 依赖全部排除（esbuild 已内联内核到 dist/extension/extension.js）
node_modules/**
**/node_modules/**

# 其他
.vscode/**
.svscodeignore
*.vsix
dist/**/*.map
# 构建戳（仅本地门禁 verify-dist-contract 消费，运行时不读，不入包）
dist/.build-stamp.json
# 编译产物中的测试文件（tsc 会把 src/__tests__ 一并编译进 dist，分发时排除）
**/__tests__/**

# 本地日志与工具临时产物（2026-10-26 实测曾混入 vsix：验收前打包残留）
# `.workbuddy/**` = 本地调试日志（.gitignore 已忽略，但 vsce 不看 .gitignore）
.workbuddy/**
.tmp-vsce.log
*.log

# 手工验收脚本（仅本地按 docs/mcp-acceptance.md 手工跑，扩展运行时零读取）
mcp-acceptance-server.mjs

# 打包前门禁的 bundle 探针（仅 scripts/verify-bundle-loadable.mjs 消费，编译期生成）
dist/.bundle-smoke/**

# 设计源稿（仅存档用，成品已固化为 icon.png / icon-activitybar.svg，不入安装包）
resources/*.jpeg
