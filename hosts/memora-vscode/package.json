{
  "name": "memora-vscode",
  "displayName": "Memora",
  "description": "Memora 内核的 VS Code 落地宿主：通用对话 + 记忆 + 角色包定位（出厂自带文档打磨角色）",
  "version": "0.0.1",
  "publisher": "zooique",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zooique/memora.git"
  },
  "homepage": "https://gitee.com/zooique/memora#readme",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memora.open",
        "title": "Memora: 打开对话面板",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "memora.configureModel",
        "title": "Memora: 配置大模型",
        "icon": "$(gear)"
      },
      {
        "command": "memora.memoryStats",
        "title": "Memora: 查看记忆统计"
      },
      {
        "command": "memora.cleanupMemories",
        "title": "Memora: 清理过期记忆"
      },
      {
        "command": "memora.runGc",
        "title": "Memora: 立即执行孤儿回收",
        "icon": "$(trash)"
      },
      {
        "command": "memora.demo",
        "title": "Memora: 运行能力演示（隔离演示区）"
      },
      {
        "command": "memora.registerWork",
        "title": "Memora: 登记作品投影",
        "icon": "$(file-text)"
      }
    ],
    "configuration": {
      "title": "Memora",
      "properties": {
        "memora.providers": {
          "type": "array",
          "default": [],
          "description": "已配置的大模型服务商列表（不含 API Key，Key 存储在安全存储中）"
        },
        "memora.activeProvider": {
          "type": "string",
          "default": "",
          "description": "当前激活的大模型服务商别名"
        },
        "memora.showMetrics": {
          "type": "boolean",
          "default": false,
          "description": "显示活动指标（LLM 调用次数 / 召回命中率 / 指纹 hash 等调试信息）。默认隐藏，对普通用户是噪音；需要调试可观测性时开启"
        },
        "memora.allowedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "白名单额外允许目录（项目目录之外的可信目录，Agent 可读取/写入）。项目目录始终允许，无需添加。修改即时生效，重启后仍保留。"
        },
        "memora.maxContextTokens": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 2000000,
          "description": "上下文窗口上限（token）。Agent 预算路径据此分配对话与记忆空间；设置过小会导致长对话被更早截断。修改即时生效，重启后仍保留。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memora",
          "title": "Memora",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "memora": [
        {
          "type": "webview",
          "id": "memora.chat",
          "name": "对话"
        },
        {
          "type": "webview",
          "id": "memora.settings",
          "name": "设置"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "memora.registerWork",
          "when": "!explorerResourceIsRoot",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "memora.registerWork",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p ./ && node esbuild.config.mjs",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "package": "npm run compile && vsce package --out memora-vscode.vsix",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --no-file-parallelism"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "@zooique/memora": "file:../..",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}


