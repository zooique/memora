{
  "name": "memora-vscode",
  "displayName": "Memora",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "zooique",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zooique/memora.git"
  },
  "homepage": "https://github.com/zooique/memora#readme",
  "bugs": {
    "url": "https://github.com/zooique/memora/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "assistant",
    "llm",
    "memory",
    "agent",
    "role",
    "local llm",
    "openai compatible",
    "documentation",
    "productivity"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memora.open",
        "title": "%command.open.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "memora.configureModel",
        "title": "%command.configureModel.title%",
        "icon": "$(gear)"
      },
      {
        "command": "memora.openRoles",
        "title": "%command.openRoles.title%",
        "icon": "$(person)"
      },
      {
        "command": "memora.openSettings",
        "title": "%command.openSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "memora.attachImage",
        "title": "%command.attachImage.title%"
      },
      {
        "command": "memora.memoryStats",
        "title": "%command.memoryStats.title%"
      },
      {
        "command": "memora.cleanupMemories",
        "title": "%command.cleanupMemories.title%"
      },
      {
        "command": "memora.runGc",
        "title": "%command.runGc.title%",
        "icon": "$(trash)"
      },
      {
        "command": "memora.resetUserData",
        "title": "%command.resetUserData.title%"
      },
      {
        "command": "memora.demo",
        "title": "%command.demo.title%"
      },
      {
        "command": "memora.reloadSkills",
        "title": "%command.reloadSkills.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "memora.registerWork",
        "title": "%command.registerWork.title%",
        "icon": "$(file-text)"
      },
      {
        "command": "memora.addToChat",
        "title": "%command.addToChat.title%",
        "icon": "$(references)"
      },
      {
        "command": "memora.reviewFileChanges",
        "title": "%command.reviewFileChanges.title%",
        "icon": "$(diff)"
      },
      {
        "command": "memora.confirmAllFileChanges",
        "title": "%command.confirmAllFileChanges.title%",
        "icon": "$(check-all)"
      },
      {
        "command": "memora.revertAllFileChanges",
        "title": "%command.revertAllFileChanges.title%",
        "icon": "$(discard)"
      },
      {
        "command": "memora.fileChange.confirmFile",
        "title": "%command.fileChange.confirmFile.title%",
        "icon": "$(check)"
      },
      {
        "command": "memora.fileChange.restoreFile",
        "title": "%command.fileChange.restoreFile.title%",
        "icon": "$(discard)"
      },
      {
        "command": "memora.copyDiagnostics",
        "title": "%command.copyDiagnostics.title%",
        "icon": "$(copy)"
      }
    ],
    "configuration": {
      "title": "Memora",
      "properties": {
        "memora.providers": {
          "type": "array",
          "default": [],
          "description": "%config.providers.description%"
        },
        "memora.activeProvider": {
          "type": "string",
          "default": "",
          "description": "%config.activeProvider.description%"
        },
        "memora.backgroundProvider": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%config.backgroundProvider.description%"
        },
        "memora.showMetrics": {
          "type": "boolean",
          "default": false,
          "description": "%config.showMetrics.description%"
        },
        "memora.attentionSound": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%config.attentionSound.description%"
        },
        "memora.allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "application",
          "default": [],
          "description": "%config.allowedPaths.description%"
        },
        "memora.searchEngine": {
          "type": "string",
          "scope": "application",
          "default": "auto",
          "description": "%config.searchEngine.description%"
        },
        "memora.archiveMode": {
          "type": "string",
          "scope": "application",
          "default": "full",
          "enum": [
            "full",
            "manual"
          ],
          "description": "%config.archiveMode.description%"
        },
        "memora.customSearchEngines": {
          "type": "array",
          "scope": "application",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.customSearchEngines.name.description%"
              },
              "urlTemplate": {
                "type": "string",
                "description": "%config.customSearchEngines.urlTemplate.description%"
              },
              "parseStrategy": {
                "type": "string",
                "enum": [
                  "openSearchRss",
                  "jsonApi"
                ],
                "description": "%config.customSearchEngines.parseStrategy.description%"
              }
            },
            "required": [
              "name",
              "urlTemplate",
              "parseStrategy"
            ]
          },
          "default": [],
          "description": "%config.customSearchEngines.description%"
        },
        "memora.scriptNodePath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%config.scriptNodePath.description%"
        },
        "memora.disabledSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "application",
          "default": [],
          "description": "%config.disabledSkills.description%"
        },
        "memora.mcpServers": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.mcpServers.name.description%"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ],
                "default": "stdio",
                "description": "%config.mcpServers.transport.description%"
              },
              "command": {
                "type": "string",
                "description": "%config.mcpServers.command.description%"
              },
              "url": {
                "type": "string",
                "description": "%config.mcpServers.url.description%"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "%config.mcpServers.headers.description%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%config.mcpServers.args.description%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "%config.mcpServers.env.description%"
              },
              "cwd": {
                "type": "string",
                "description": "%config.mcpServers.cwd.description%"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "%config.mcpServers.enabled.description%"
              }
            },
            "required": [
              "name"
            ]
          },
          "description": "%config.mcpServers.description%"
        },
        "memora.mcpToolAllowlist": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%config.mcpToolAllowlist.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memora",
          "title": "Memora",
          "icon": "resources/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "memora": [
        {
          "type": "webview",
          "id": "memora.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "memora.openSettings",
          "when": "view == memora.chat",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "memora.addToChat",
          "when": "!explorerResourceIsRoot",
          "group": "navigation@8"
        },
        {
          "command": "memora.registerWork",
          "when": "!explorerResourceIsRoot && !explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "memora.addToChat",
          "group": "navigation@8"
        },
        {
          "command": "memora.registerWork",
          "when": "!editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "memora.fileChange.confirmFile",
          "when": "memora.fileChangePending",
          "group": "navigation@1"
        },
        {
          "command": "memora.fileChange.restoreFile",
          "when": "memora.fileChangePending",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "memora.open",
        "key": "ctrl+alt+m"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node scripts/gen-changelog.mjs",
    "compile": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p ./ && node esbuild.config.mjs && node scripts/verify-bundle-loadable.mjs",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p ./tsconfig.scripts.json",
    "package": "npm run compile && node scripts/gen-changelog.mjs && node scripts/verify-nls.mjs && node scripts/verify-package-manifest.mjs && vsce package --no-dependencies --baseContentUrl https://raw.githubusercontent.com/zooique/memora/main/hosts/memora-vscode/ --baseImagesUrl https://raw.githubusercontent.com/zooique/memora/main/hosts/memora-vscode/ --out memora-vscode.vsix",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --no-file-parallelism",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "@zooique/memora": "file:../..",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
