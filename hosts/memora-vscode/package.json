{
  "name": "memora-vscode",
  "displayName": "Memora",
  "description": "侧边栏 AI 助手：跨会话记忆、关键节点主动提问、角色包定位（出厂自带文档打磨角色），云端 / 本地模型均可",
  "version": "0.1.0",
  "publisher": "zooique",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zooique/memora.git"
  },
  "homepage": "https://github.com/zooique/memora#readme",
  "keywords": [
    "ai",
    "chat",
    "assistant",
    "llm",
    "memory",
    "agent",
    "role",
    "local llm",
    "openai compatible",
    "documentation",
    "productivity"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memora.open",
        "title": "Memora: 打开对话面板",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "memora.configureModel",
        "title": "Memora: 配置大模型",
        "icon": "$(gear)"
      },
      {
        "command": "memora.openRoles",
        "title": "Memora: 管理角色包",
        "icon": "$(person)"
      },
      {
        "command": "memora.memoryStats",
        "title": "Memora: 查看记忆统计"
      },
      {
        "command": "memora.cleanupMemories",
        "title": "Memora: 清理过期记忆"
      },
      {
        "command": "memora.runGc",
        "title": "Memora: 立即执行孤儿回收",
        "icon": "$(trash)"
      },
      {
        "command": "memora.resetUserData",
        "title": "Memora: 恢复初始状态（清空用户级数据）"
      },
      {
        "command": "memora.demo",
        "title": "Memora: 运行能力演示（隔离演示区）"
      },
      {
        "command": "memora.reloadSkills",
        "title": "Memora: 重载技能与角色包",
        "icon": "$(refresh)"
      },
      {
        "command": "memora.registerWork",
        "title": "Memora: 登记作品投影",
        "icon": "$(file-text)"
      },
      {
        "command": "memora.reviewFileChanges",
        "title": "Memora: 查看文件改动",
        "icon": "$(diff)"
      },
      {
        "command": "memora.confirmAllFileChanges",
        "title": "Memora: 全部确认文件改动",
        "icon": "$(check-all)"
      },
      {
        "command": "memora.revertAllFileChanges",
        "title": "Memora: 全部回退文件改动",
        "icon": "$(discard)"
      },
      {
        "command": "memora.fileChange.confirmFile",
        "title": "Memora: 确认本文件改动",
        "icon": "$(check)"
      },
      {
        "command": "memora.fileChange.restoreFile",
        "title": "Memora: 回退本文件改动",
        "icon": "$(discard)"
      }
    ],
    "configuration": {
      "title": "Memora",
      "properties": {
        "memora.providers": {
          "type": "array",
          "default": [],
          "description": "已配置的大模型服务商列表（不含 API Key，Key 存储在安全存储中）"
        },
        "memora.activeProvider": {
          "type": "string",
          "default": "",
          "description": "当前激活的大模型服务商别名"
        },
        "memora.backgroundProvider": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "后台任务（轮次摘要 / 会话归档 / 润色 / 去重）使用的服务商别名。留空 = 与实时对话相同。用户级偏好，随用户而非随项目。修改后重载窗口生效"
        },
        "memora.showMetrics": {
          "type": "boolean",
          "default": false,
          "description": "显示活动指标（LLM 调用次数 / 工具失败与截断 / token / 安全审计 / 指纹 hash 等调试信息）。默认隐藏，对普通用户是噪音；需要调试可观测性时开启"
        },
        "memora.allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "application",
          "default": [],
          "description": "白名单额外允许目录（项目目录之外的可信目录，Agent 可读取/写入）。项目目录始终允许，无需添加。用户级：机器级目录信任，个人绝对路径不进项目 settings。修改即时生效，重启后仍保留。"
        },
        "memora.searchEngine": {
          "type": "string",
          "scope": "application",
          "default": "auto",
          "description": "内部网页搜索引擎（web_search 工具使用的后端）。可选值：auto（Bing→DuckDuckGo 默认链）、bing、duckduckgo、baidu、sogou，或自定义搜索引擎名（在设置面板「自定义搜索引擎」中定义）。用户级偏好，随用户而非随项目。修改后重载窗口生效。"
        },
        "memora.archiveMode": {
          "type": "string",
          "scope": "application",
          "default": "full",
          "enum": [
            "full",
            "manual"
          ],
          "description": "会话归档模式。full=自动归档：切换/分叉离开会话时自动生成会话摘要与主题（历史列表检索用）；manual=仅手动归档：仅在用户手动触发时生成。轮次摘要不受本设置影响（总是生成）。用户级偏好，随用户而非随项目。设置面板切换即时生效（对话进行中内核拒切，偏好保存后顺延到对话结束）。"
        },
        "memora.customSearchEngines": {
          "type": "array",
          "scope": "application",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "引擎显示名（唯一，作为选择器值）"
              },
              "urlTemplate": {
                "type": "string",
                "description": "搜索 URL 模板，查询占位符用 {query}（如 https://example.com/search?q={query}）"
              },
              "parseStrategy": {
                "type": "string",
                "enum": [
                  "openSearchRss",
                  "jsonApi"
                ],
                "description": "结果解析策略（宿主预置，不可自定义解析逻辑）。openSearchRss=OpenSearch RSS/Atom；jsonApi=JSON 搜索 API（约定 {results:[{title,url,snippet}]} 或 {items:[...]}）"
              }
            },
            "required": [
              "name",
              "urlTemplate",
              "parseStrategy"
            ]
          },
          "default": [],
          "description": "用户自定义网页搜索引擎（web_search 工具后端）。每项 = 名称 + URL 模板(?q={query}) + 宿主预置解析策略。仅支持结构化结果源，自定义 HTML 解析不可行（安全红线）。修改后重载窗口生效。"
        },
        "memora.scriptNodePath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "脚本执行的 node 可执行文件绝对路径（可选）。供 run_skill_script / run_project_script 的 node 脚本使用；留空时走系统 PATH 查找 node。宿主机无独立 node（技能脚本报 ENOENT）时配置此项，如内置运行时的 node 路径。修改后需重载窗口生效。"
        },
        "memora.disabledSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "application",
          "default": [],
          "description": "禁用的技能名列表（配置形态启停）。作用域 = 全局技能池（内置技能 + 用户技能）；激活角色包的内嵌技能是「随角色激活」的另一套语义，不受本设置影响。命中者对模型语义 = 不存在：不进技能清单、read_skill 读不到、L3 资源与脚本不可达；技能页仍保留条目并加「已禁用」徽章（便于对照确认是否生效，不静默消失）。技能名 = 技能清单中列出的名称（Agent Skills 规范：kebab，如 code-review）。用户级偏好，随用户而非随项目。修改后即时生效——自动同步到内核并刷新技能页与对话区技能下拉，无需重载窗口或手动重载。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memora",
          "title": "Memora",
          "icon": "resources/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "memora": [
        {
          "type": "webview",
          "id": "memora.chat",
          "name": "对话"
        },
        {
          "type": "webview",
          "id": "memora.settings",
          "name": "设置"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "memora.registerWork",
          "when": "!explorerResourceIsRoot",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "memora.registerWork",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "memora.fileChange.confirmFile",
          "when": "memora.fileChangePending",
          "group": "navigation@1"
        },
        {
          "command": "memora.fileChange.restoreFile",
          "when": "memora.fileChangePending",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "memora.open",
        "key": "ctrl+alt+m"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p ./ && node esbuild.config.mjs",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p ./tsconfig.scripts.json",
    "package": "npm run compile && vsce package --no-dependencies --baseContentUrl https://raw.githubusercontent.com/zooique/memora/main/hosts/memora-vscode/ --baseImagesUrl https://raw.githubusercontent.com/zooique/memora/main/hosts/memora-vscode/ --out memora-vscode.vsix",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --no-file-parallelism",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "@zooique/memora": "file:../..",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
