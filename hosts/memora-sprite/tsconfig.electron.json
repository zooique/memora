{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist-electron",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/electron/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "src/electron/preload.ts",
    "src/electron/preloadQuickInput.ts",
    "src/electron/preloadFloat.ts"
  ]
}
