{
  "name": "memora-sprite",
  "version": "0.1.0",
  "description": "Memora 精灵桌面伴侣——能自我进化的本地 AI Agent",
  "type": "module",
  "main": "./dist-electron/electron/main.js",
  "bin": {
    "memora-sprite": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-renderer.mjs",
    "build:all": "npm run build && npm run build:electron",
    "start": "tsx src/index.ts",
    "start:electron": "npm run build:electron && electron ./dist-electron/electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron": "^40.0.0",
    "memora": "file:../.."
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
