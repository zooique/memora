{
  "name": "memora-sprite",
  "version": "1.3.0",
  "description": "Memora 精灵桌面伴侣——能自我进化的本地 AI Agent",
  "type": "module",
  "main": "./dist-electron/electron/main.js",
  "bin": {
    "memora-sprite": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build:electron": "npm run sync-memora && npm run check-ipc && npm run generate-icons && node --input-type=module -e \"import{mkdirSync}from'node:fs';mkdirSync('dist-electron',{recursive:true})\" && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node scripts/build-preload.mjs && node scripts/copy-renderer.mjs",
    "sync-memora": "node scripts/sync-memora.mjs",
    "build:web": "tsc -p tsconfig.web.json",
    "start:electron": "chcp 65001 >nul && set NODE_ENV=production&& npm run build:electron && set NODE_ENV=production&& electron ./dist-electron/electron/main.js",
    "dev:electron": "chcp 65001 >nul && set NODE_ENV=development&& npm run build:electron && node scripts/dev-watch.mjs",
    "dev:web": "set NODE_ENV=development&& npm run build:electron && tsx src/web/server.ts",
    "start": "tsx src/cli.ts",
    "start:web": "set NODE_ENV=production&& npm run build:web && node dist-web/web/server.js",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "npm run check-configs && eslint . --ext .ts && npm run lint:css",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:css": "stylelint \"src/electron/renderer/styles/**/*.css\"",
    "lint:css:fix": "stylelint \"src/electron/renderer/styles/**/*.css\" --fix",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "check-ipc": "npx tsx scripts/check-ipc-channels.ts",
    "check-cli-keys": "npx tsx scripts/check-cli-config-keys.ts",
    "check-configs": "npm run check-ipc && npm run check-cli-keys",
    "rebuild": "electron-builder install-app-deps",
    "package:win": "npm run build:electron && node scripts/clean-release.mjs && node scripts/package.mjs --win --x64",
    "package:mac": "npm run build:electron && node scripts/clean-release.mjs && node scripts/package.mjs --mac",
    "package:linux": "npm run build:electron && node scripts/clean-release.mjs && node scripts/package.mjs --linux",
    "package:all": "npm run build:electron && node scripts/clean-release.mjs && node scripts/package.mjs --win --mac --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "better-sqlite3": "^12.10.0",
    "koffi": "^3.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.memora.sprite",
    "productName": "Memora Sprite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      {
        "from": "node_modules/memora",
        "to": "node_modules/memora"
      },
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "asar": true,
    "icon": "build/icons/icon.png",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memora Sprite"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@40.10.6": true,
    "esbuild@0.28.1": true,
    "koffi@3.1.1": true,
    "sharp@0.35.3": true
  }
}
