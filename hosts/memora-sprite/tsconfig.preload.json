{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist-preload",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/electron/preload.ts",
    "src/electron/preloadQuickInput.ts",
    "src/electron/preloadFloat.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
