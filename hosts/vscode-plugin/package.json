{
  "name": "memora-doc-review",
  "displayName": "Memora Doc Review",
  "description": "用 AI 打磨项目设计文档到自洽，再动手写代码（Memora 内核宿主）",
  "version": "0.0.1",
  "publisher": "zooique",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memoraDocReview.open",
        "title": "Memora: 打开设计文档打磨"
      },
      {
        "command": "memoraDocReview.review",
        "title": "Memora: 审阅当前文档自洽性"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@zooique/memora": "file:../.."
  }
}
