{
  "llm": {
    "providers": {
      "mimimo": {
        "provider": "mimimo",
        "model": "deepseek-chat",
        "apiKey": "${MEMORA_API_KEY}",
        "baseUrl": "https://api.xiaomimimo.com/v1",
        "temperature": 0.7,
        "contextWindow": 128000,
        "supportsToolCalling": true,
        "supportsStructuredOutput": false
      },
      "openai": {
        "provider": "openai",
        "model": "gpt-4o",
        "apiKey": "${MEMORA_OPENAI_API_KEY}",
        "baseUrl": "https://api.openai.com/v1",
        "temperature": 0.7,
        "contextWindow": 128000,
        "supportsToolCalling": true,
        "supportsStructuredOutput": true
      }
    },
    "active": "mimimo"
  },
  "memory": {
    "dataDir": "~/.memora",
    "maxContextTokens": 1000000
  },
  "security": {
    "permission": "owner",
    "confirmWrites": false
  },
  "allowedPaths": []
}
