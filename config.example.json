{
  "llm": {
    "providers": {
      "deepseek": {
        "provider": "deepseek",
        "model": "deepseek-chat",
        "apiKey": "${MEMORA_API_KEY}",
        "baseUrl": "https://api.xiaomimimo.com/v1"
      },
      "openai": {
        "provider": "openai",
        "model": "gpt-4o",
        "apiKey": "${MEMORA_OPENAI_API_KEY}",
        "baseUrl": "https://api.openai.com/v1"
      }
    },
    "active": "deepseek",
    "background": {
      "provider": "doubao",
      "model": "doubao-pro",
      "apiKey": "${MEMORA_BACKGROUND_API_KEY}",
      "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
      "temperature": 0.5
    }
  },
  "embedding": {
    "model": "text-embedding-3-small",
    "apiKey": "${MEMORA_EMBEDDING_API_KEY}",
    "baseUrl": "https://api.openai.com/v1"
  },
  "memory": {
    "dataDir": "~/.memora",
    "maxContextTokens": 120000
  },
  "security": {
    "permission": "owner",
    "confirmWrites": false
  },
  "allowedPaths": []
}
