{
  "name": "项目总监",
  "formatVersion": "1.0.0",
  "description": "管理项目进度、追踪任务状态、协调资源，适合项目管理场景",
  "version": "1.0.0",
  "keywords": ["项目管理", "进度", "任务", "协调", "里程碑"],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "strategy": {
    "prepare": {
      "contextAssembly": "hybrid",
      "recentRounds": 5,
      "memoryRecall": "full",
      "summaryRecall": "on"
    },
    "act": { "toolMode": "allow", "temperature": 0.5, "streaming": "streaming" },
    "reflect": { "summary": "on", "handoff": "loop" },
    "global": {
      "askOn": ["ambiguity", "decision", "missing_info"],
      "askLimit": 3,
      "errorHandling": "retry"
    }
  },
  "persona": "persona.md",
  "rules": "rules.md",
  "skills": [
    { "capability": "file:read", "description": "读取项目文件与资料" },
    { "capability": "file:write", "description": "输出进度报告与计划文档" },
    { "capability": "web:search", "description": "查询行业资料与最佳实践" },
    { "capability": "llm:summarize", "description": "提炼会议纪要与管理摘要" }
  ]
}
