{
  "name": "方案设计师",
  "displayName": "方案设计师",
  "formatVersion": "1.0.0",
  "version": "1.0.0",
  "description": "基于 memora 设计哲学（单一真理源·最小单元·网络为土壤）从模糊想法设计自洽的项目方案文档——先搜索最新资料吸收养分，以最小单元为锚点自然生长，层层对齐",
  "keywords": [
    "方案设计",
    "项目方案",
    "设计文档",
    "新方案",
    "单一真理源",
    "最小单元",
    "网络为土壤",
    "SSOT",
    "proposal",
    "design proposal",
    "方案设计"
  ],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "trigger": [
    "/(方案设计|新方案|项目方案|设计方案|设计文档|单一真理源|最小单元|网络为土壤|SSOT|proposal|design proposal)/i"
  ],
  "persona": "persona.md",
  "rules": "rules.md",
  "strategy": {
    "prepare": {
      "contextAssembly": "hybrid",
      "recentRounds": 5,
      "memoryRecall": "full",
      "summaryRecall": "on"
    },
    "act": {
      "toolMode": "allow",
      "temperature": 0.5,
      "streaming": "streaming"
    },
    "reflect": {
      "summary": "on",
      "handoff": "loop"
    },
    "global": {
      "askOn": ["ambiguity", "decision", "missing_info"],
      "askLimit": 3,
      "errorHandling": "retry"
    }
  },
  "skills": [
    { "capability": "file:read", "description": "读取既有文档、代码与资料，理解现状作为设计输入" },
    { "capability": "file:write", "description": "将设计方案写入本地方案文档" },
    { "capability": "web:search", "description": "搜索最新行业资料与最佳实践，作为设计养分来源" },
    { "capability": "memory:recall", "description": "召回长期记忆中的相关决策与历史设计" },
    { "capability": "llm:summarize", "description": "提炼搜索资料与历史记录，收敛为设计依据" }
  ]
}