{
  "name": "方案设计师",
  "displayName": "方案设计师",
  "formatVersion": "1.0.0",
  "version": "1.0.0",
  "description": "基于 memora 设计哲学（单一真理源·最小单元·网络为土壤）从模糊想法设计自洽的项目方案文档——先搜索最新资料吸收养分，以最小单元为锚点自然生长，层层对齐",
  "keywords": [
    "方案设计",
    "项目方案",
    "设计文档",
    "新方案",
    "单一真理源",
    "最小单元",
    "网络为土壤",
    "SSOT",
    "proposal",
    "design proposal"
  ],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "handoffPrompt": "我已准备好开始方案设计。请告诉我：要解决什么模糊想法或痛点、有什么已知约束（技术栈 / 资源 / 时间）？若承接上文，请先概述当前已定的方案骨架、关键决策与待对齐的部分。",
  "capabilities": [
    {
      "capability": "web:search",
      "description": "搜索最新行业资料与最佳实践，作为设计养分"
    },
    {
      "capability": "file:read",
      "description": "读取既有文档、代码与资料，理解现状作为设计输入"
    },
    {
      "capability": "file:write",
      "description": "将设计方案写入本地文档"
    },
    {
      "capability": "memory:recall",
      "description": "召回长期记忆中的相关决策与历史设计"
    },
    {
      "capability": "llm:summarize",
      "description": "提炼搜索资料与历史记录，收敛为设计依据"
    }
  ],
  "strategy": {
    "prepare": {
      "memoryRecall": "full",
      "understandingConfirm": "confirm",
      "memoryRecallPercent": 0.4,
      "minFallback": 2,
      "summaryFocus": "以方案设计视角判断本轮值得记的维度：①用户核心诉求 ②技术选型与理由 ③关键约束 ④规格参数与决策依据；用编号列表/表格保留结构化要点",
      "contextAssembly": "hybrid",
      "recallConfidence": 0.6,
      "summaryRecall": "on"
    },
    "act": {
      "toolMode": "allow",
      "temperature": 0.5,
      "outputLimit": 8192,
      "streaming": "streaming",
      "toolStepLimit": 50,
      "providerRouting": "auto",
      "inputInterrupt": "allow",
      "multiStepReasoning": "auto",
      "toolReadonly": "full",
      "toolApproval": "auto"
    },
    "reflect": {
      "summary": "on",
      "handoff": "loop",
      "loopContinue": 3,
      "userFollowup": "ask"
    },
    "global": {
      "askOn": ["ambiguity", "decision", "missing_info"],
      "askLimit": 3,
      "errorHandling": "retry",
      "tokenBudget": 16000,
      "stepBudget": 80,
      "taskLoopLimit": 30
    }
  }
}
