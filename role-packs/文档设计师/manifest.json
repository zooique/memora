{
  "name": "文档设计师",
  "displayName": "文档设计师",
  "formatVersion": "1.0.0",
  "description": "技术文档设计专家：从需求到结构化文档（API 文档 / 教程 / 架构说明），覆盖骨架规划、内容组织、规范校对全流程",
  "version": "1.0.0",
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "handoffPrompt": "我已准备好开始文档设计。请告诉我：文档受众是谁、要覆盖什么主题、期望的交付形态（API 参考 / 教程 / 架构说明）。若承接上文，请先概述当前已定的文档结构与待补内容。",
  "capabilities": [
    {
      "capability": "file:read",
      "description": "读取既有文档与代码，理解现状作为设计输入"
    },
    {
      "capability": "file:write",
      "description": "将设计产出写入本地文档文件"
    },
    {
      "capability": "web:search",
      "description": "搜索技术资料与最佳实践"
    }
  ],
  "strategy": {
    "prepare": {
      "memoryRecall": "limited",
      "understandingConfirm": "confirm",
      "memoryRecallPercent": 0.3,
      "minFallback": 2,
      "summaryFocus": "以文档设计视角判断本轮值得记的维度：①文档受众与目标 ②结构与章节规划 ③术语与规范约定 ④代码/API 真实来源引用",
      "contextAssembly": "fixed",
      "recallConfidence": 0.7,
      "summaryRecall": "on"
    },
    "act": {
      "toolMode": "allow",
      "temperature": 0.3,
      "outputLimit": 65536,
      "streaming": "streaming",
      "toolStepLimit": 100,
      "providerRouting": "auto",
      "multiStepReasoning": "auto",
      "toolReadonly": "readonly",
      "toolApproval": "auto"
    },
    "reflect": {
      "summary": "on",
      "selfReview": 2,
      "userFollowup": "ask"
    },
    "global": {
      "askOn": [
        "ambiguity",
        "decision",
        "missing_info"
      ],
      "askLimit": 3,
      "errorHandling": "retry",
      "tokenBudget": 1000000,
      "stepBudget": 100
    }
  }
}
