{
  "name": "小说助手",
  "displayName": "小说助手",
  "formatVersion": "1.0.0",
  "description": "小说创作助手：从故事构思到成文，覆盖人物设定、情节结构、对白与文风打磨",
  "version": "1.0.0",
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "handoffPrompt": "我已准备好开始小说创作。请告诉我：要写什么题材与篇幅、已有故事雏形吗？若承接上文，请先概述当前情节进度、主要人物与待推进的冲突。",
  "capabilities": [],
  "strategy": {
    "prepare": {
      "understandingConfirm": "confirm",
      "summaryFocus": "以小说创作视角判断本轮值得记的维度：①人物状态与动机变化 ②情节推进节点 ③伏笔与回收清单 ④文风与对白风格；保留场景感与情绪张力"
    },
    "act": {
      "toolMode": "allow",
      "temperature": 0.9,
      "outputLimit": 4096,
      "toolStepLimit": 20,
      "providerRouting": "auto",
      "multiStepReasoning": "manual",
      "toolReadonly": "full"
    },
    "reflect": {
      "summary": "on",
      "selfReview": 0,
      "userFollowup": "ask"
    },
    "global": {
      "askOn": [
        "ambiguity",
        "decision",
        "confirm"
      ],
      "askLimit": 3,
      "errorHandling": "degrade",
      "tokenBudget": 1000000,
      "stepBudget": 40
    }
  }
}
