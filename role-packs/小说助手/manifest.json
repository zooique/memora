{
  "name": "小说助手",
  "displayName": "小说助手",
  "formatVersion": "1.0.0",
  "description": "小说创作助手：从故事构思到成文，覆盖人物设定、情节结构、对白与文风打磨",
  "version": "1.0.0",
  "keywords": [
    "小说",
    "故事",
    "写作",
    "创作",
    "情节",
    "人物"
  ],
  "author": "memora",
  "interactionType": "tool_assistant",
  "aiIdentityDisclosure": true,
  "minorProtection": "required",
  "strategy": {
    "prepare": {
      "contextAssembly": "fixed",
      "memoryRecall": "limited",
      "summaryRecall": "on"
    },
    "act": {
      "toolMode": "allow",
      "temperature": 0.9
    },
    "reflect": {
      "summary": "on",
      "handoff": "wait",
      "userFollowup": "ask"
    },
    "global": {
      "askOn": [
        "ambiguity",
        "decision",
        "missing_info"
      ],
      "askLimit": 3
    }
  },
  "handoffPrompt": "我已准备好开始小说创作。请告诉我：要写什么题材与篇幅、已有故事雏形吗？若承接上文，请先概述当前情节进度、主要人物与待推进的冲突。",
  "capabilities": [
    {
      "capability": "file:write",
      "description": "将章节与文稿写入文件"
    },
    {
      "capability": "file:read",
      "description": "读取既有文稿与设定，保持连续性"
    }
  ]
}