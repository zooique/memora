{
  // scripts/ 类型检查专用配置（noEmit）——根 tsconfig 只 include src/，
  // scripts/*.ts 长期在任何 typecheck 门外（坏了仅 IDE 可见、tsx 照跑），
  // 本配置把验证/基准脚本纳入 typecheck 门，经 package.json#typecheck 消费。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // 本 program 输入 scripts/**、依赖经 paths 解析到 src/**——两目录公共祖先 = 项目根，
    // 须显式覆盖根配置的 rootDir: "./src"，否则 TS6059（rootDir 须含全部输入文件）爆 18 个。
    // noEmit 下 rootDir 无输出布局语义，显式仅为满足该输入校验（TS 6/7 要求 rootDir 显式化）。
    "rootDir": ".",
    // 包自引用（hosts 源码经 @zooique/memora 消费内核）重定向到 src 单一真源，
    // 禁止 dist/*.d.ts 声明树混入本编译单元——src 与 dist 双份类型并行会互相遮蔽（幻影报错源）。
    // 注意：paths 整体覆盖不合并，须连同 @/* 一并重申；目标基准 = tsconfig 位置（baseUrl 已弃用移除，TS 7 不再支持）。
    "paths": {
      "@/*": ["./src/*"],
      "@zooique/memora": ["./src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
