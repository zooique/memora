{
  // scripts/ 类型检查专用配置（noEmit）——根 tsconfig 只 include src/，
  // scripts/*.ts 长期在任何 typecheck 门外（坏了仅 IDE 可见、tsx 照跑），
  // 本配置把验证/基准脚本纳入 typecheck 门，经 package.json#typecheck 消费。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // 包自引用（hosts 源码经 @zooique/memora 消费内核）重定向到 src 单一真源，
    // 禁止 dist/*.d.ts 声明树混入本编译单元——src 与 dist 双份类型并行会互相遮蔽（幻影报错源）。
    // 注意：paths 整体覆盖不合并，须连同 @/* 一并重申。
    "paths": {
      "@/*": ["./*"],
      "@zooique/memora": ["./index.ts"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
