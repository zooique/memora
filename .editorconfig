# REL-3.1 C4（2026-10-10）：编辑器行为统一配置。格式化真源仍是 .prettierrc
# （本文件管 prettier 覆盖不到的面：md/yaml 等非 format 面的编辑器保存行为）。
# 换行符背景见 .gitattributes 头注（FMT-PRETTIER-1）：ts/json 已由 .gitattributes
# 固化 eol=lf；本文件对全类型声明 lf 与之对齐，md 不在 format 面但同样按 lf 保存。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown：行尾双空格是硬换行语义，禁剪
[*.md]
trim_trailing_whitespace = false
