{
  "llm": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "apiKey": "${MEMORA_LLM_API_KEY}",
    "baseUrl": "https://api.deepseek.com/v1",
    "temperature": 0.7
  },
  "memory": {
    "dataDir": "~/.memora",
    "maxContextTokens": 120000
  },
  "security": {
    "permission": "owner",
    "confirmWrites": false
  },
  "allowedPaths": ["${HOME}/projects"]
}
